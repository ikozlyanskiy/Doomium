<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Doomium</AssemblyName>
    <RootNamespace>Doomium</RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.3.0-preview.2</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <NoWarn>$(NoWarn);CS8765;CS8767</NoWarn>

    <AltiumInstallDir Condition="'$(AltiumInstallDir)' == ''">C:\Program Files\Altium\AD25</AltiumInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="vendor\managed-doom\ManagedDoom\src\**\*.cs"
             Exclude="vendor\managed-doom\ManagedDoom\src\Silk\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Altium.Dxp.Classes">
      <HintPath>$(AltiumInstallDir)\System\Altium.Dxp.Classes.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Altium.Dxp.Interfaces">
      <HintPath>$(AltiumInstallDir)\System\Altium.Dxp.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Altium.SDK.Interfaces">
      <HintPath>$(AltiumInstallDir)\System\Altium.SDK.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
